"""
Sheet Trace Visualizer
======================
Turns a workpaper "flow" Excel sheet into a swimlane trace diagram.

Expected columns (case-insensitive, spaces/underscores flexible):
    Stage            -> Input / Calculated / Output
    Step No.         -> sequence number (int)
    Report/Schedule  -> name of the report or schedule
    System/Location  -> file/system name (SAP FICO, Longview, Corptax, Excel, etc.)
    Action           -> short description of what happens at this step
    I/O              -> Input / Output / Calculated / Upload / Download / Run
    Standard         -> Y/N or standard reference (shown as a small tag)

Usage:
    python sheet_trace.py --file "your_workpaper_flow.xlsx" --sheet "Sheet1"

Output:
    sheet_trace.png  (and sheet_trace.html if --html is passed)
"""

import argparse
import sys
import textwrap
import pandas as pd
import matplotlib.pyplot as plt
import matplotlib.patches as mpatches
from matplotlib.patches import FancyBboxPatch, FancyArrowPatch
import matplotlib.lines as mlines


# ---------------------------------------------------------------------------
# Column normalization — maps flexible header names to a canonical set
# ---------------------------------------------------------------------------
COLUMN_ALIASES = {
    "stage": "stage",
    "step no": "step",
    "step no.": "step",
    "step": "step",
    "report/schedule": "report",
    "report": "report",
    "schedule": "report",
    "system/location": "system",
    "system": "system",
    "location": "system",
    "action": "action",
    "i/o": "io",
    "io": "io",
    "standard": "standard",
}

STAGE_COLORS = {
    "input": "#4C72B0",
    "calculated": "#DD8452",
    "output": "#55A868",
}

IO_STYLES = {
    "input": dict(linestyle="-", color="#4C72B0"),
    "output": dict(linestyle="-", color="#55A868"),
    "calculated": dict(linestyle="--", color="#DD8452"),
    "upload": dict(linestyle="-.", color="#8172B2"),
    "download": dict(linestyle="-.", color="#937860"),
    "run": dict(linestyle=":", color="#C44E52"),
}


def normalize_columns(df: pd.DataFrame) -> pd.DataFrame:
    new_cols = {}
    for c in df.columns:
        key = str(c).strip().lower()
        canon = COLUMN_ALIASES.get(key)
        if canon:
            new_cols[c] = canon
    df = df.rename(columns=new_cols)
    required = {"stage", "step", "report", "system", "action", "io"}
    missing = required - set(df.columns)
    if missing:
        raise ValueError(
            f"Could not find these required columns in the file: {missing}\n"
            f"Columns found were: {list(df.columns)}\n"
            f"Edit COLUMN_ALIASES at the top of this script if your headers differ."
        )
    if "standard" not in df.columns:
        df["standard"] = ""
    return df


def wrap(text, width=22):
    if pd.isna(text):
        return ""
    return "\n".join(textwrap.wrap(str(text), width=width))


def build_trace(df: pd.DataFrame, title: str = "Workpaper Adjustment Flow — Sheet Trace"):
    df = df.sort_values("step").reset_index(drop=True)

    systems = list(dict.fromkeys(df["system"].fillna("Unspecified")))  # preserve order, dedupe
    lane_y = {sys_name: i for i, sys_name in enumerate(reversed(systems))}

    n_steps = df["step"].nunique()
    fig_w = max(10, n_steps * 1.9)
    fig_h = max(4, len(systems) * 1.4 + 1.5)

    fig, ax = plt.subplots(figsize=(fig_w, fig_h))

    # Draw swimlanes
    for sys_name, y in lane_y.items():
        ax.axhspan(y - 0.4, y + 0.4, color="#f2f2f2" if y % 2 == 0 else "#ffffff", zorder=0)
        ax.text(-0.6, y, wrap(sys_name, 18), ha="right", va="center",
                 fontsize=9, fontweight="bold", color="#333333")

    node_positions = {}
    box_w, box_h = 1.3, 0.6
    x_scale = 1.8  # horizontal spacing multiplier between steps

    for _, row in df.iterrows():
        step = row["step"]
        sys_name = row["system"] if not pd.isna(row["system"]) else "Unspecified"
        y = lane_y[sys_name]
        x = step * x_scale

        stage_key = str(row["stage"]).strip().lower() if not pd.isna(row["stage"]) else ""
        color = STAGE_COLORS.get(stage_key, "#999999")

        box = FancyBboxPatch(
            (x - box_w / 2, y - box_h / 2), box_w, box_h,
            boxstyle="round,pad=0.05,rounding_size=0.08",
            linewidth=1.2, edgecolor=color, facecolor=color, alpha=0.18, zorder=3,
        )
        ax.add_patch(box)

        label = f"Step {step}\n{wrap(row['report'], 20)}\n{wrap(row['action'], 24)}"
        ax.text(x, y, label, ha="center", va="center", fontsize=7.5, zorder=4)

        if str(row.get("standard", "")).strip() not in ("", "nan", "N", "No"):
            ax.text(x + box_w / 2 - 0.05, y + box_h / 2 - 0.05, "★",
                     fontsize=9, color="#B8860B", ha="right", va="top", zorder=5)

        node_positions[step] = (x, y)

    # Draw arrows connecting consecutive steps (in step-number order)
    steps_sorted = sorted(node_positions.keys())
    for i in range(len(steps_sorted) - 1):
        s1, s2 = steps_sorted[i], steps_sorted[i + 1]
        x1, y1 = node_positions[s1]
        x2, y2 = node_positions[s2]

        io_row = df[df["step"] == s2].iloc[0]
        io_key = str(io_row["io"]).strip().lower() if not pd.isna(io_row["io"]) else ""
        style = IO_STYLES.get(io_key, dict(linestyle="-", color="#666666"))

        arrow = FancyArrowPatch(
            (x1 + box_w / 2, y1), (x2 - box_w / 2, y2),
            connectionstyle=f"arc3,rad={0.15 if y1 != y2 else 0}",
            arrowstyle="-|>", mutation_scale=14,
            linewidth=1.4, zorder=2, **style,
        )
        ax.add_patch(arrow)

    # Legends
    stage_handles = [mpatches.Patch(facecolor=c, edgecolor=c, alpha=0.3, label=s.title())
                      for s, c in STAGE_COLORS.items()]
    io_handles = [mlines.Line2D([], [], color=v["color"], linestyle=v["linestyle"], label=k.title())
                   for k, v in IO_STYLES.items()]

    leg1 = ax.legend(handles=stage_handles, title="Stage", loc="upper left",
                       bbox_to_anchor=(1.01, 1.0), fontsize=8, title_fontsize=9)
    ax.add_artist(leg1)
    ax.legend(handles=io_handles, title="I/O type", loc="upper left",
               bbox_to_anchor=(1.01, 0.55), fontsize=8, title_fontsize=9)

    ax.set_xlim(min(steps_sorted) * x_scale - 1.5, max(steps_sorted) * x_scale + 1.5)
    ax.set_ylim(-1, len(systems))
    ax.set_yticks([])
    ax.set_xticks([s * x_scale for s in steps_sorted])
    ax.set_xticklabels([str(s) for s in steps_sorted])
    ax.set_xlabel("Step No.", fontsize=10)
    ax.set_title(title, fontsize=13, fontweight="bold", pad=15)
    ax.spines[["top", "right", "left"]].set_visible(False)
    fig.tight_layout()
    return fig


def main():
    parser = argparse.ArgumentParser(description="Build a sheet-trace diagram from a workpaper flow Excel file.")
    parser.add_argument("--file", required=True, help="Path to the Excel file")
    parser.add_argument("--sheet", default=0, help="Sheet name or index (default: first sheet)")
    parser.add_argument("--out", default="sheet_trace.png", help="Output image path")
    parser.add_argument("--title", default="Workpaper Adjustment Flow — Sheet Trace", help="Chart title")
    args = parser.parse_args()

    df = pd.read_excel(args.file, sheet_name=args.sheet)
    df = normalize_columns(df)
    fig = build_trace(df, title=args.title)
    fig.savefig(args.out, dpi=200, bbox_inches="tight")
    print(f"Saved trace diagram to {args.out}")


if __name__ == "__main__":
    main()
